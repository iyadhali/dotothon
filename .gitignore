web/package-lock.json
qgis/*.qgd
qgis/*.gpkg-shm
qgis/*.gpkg-wal
qgis/*.qgs~
tools/.deps/

# --- Local research datasets (not versioned) ---------------------------
# Raw and derived datasets (~3.7 GB on disk) stay local only. Download links
# are in README.md (Data section) and data/README.md; the derived multimodal
# artifacts are rebuilt with scripts/multimodal/.
# Public-source snapshots committed before this rule stay tracked: gitignore
# never applies to files git already tracks.
data/**
# Upstream MBS datasets repo clone (nested git repo):
# https://github.com/mbs-datathon/maldives-datathon-2026-datasets
data/mbs-datasets/
# Documentation is the exception. To version a new file under data/:
#   git add -f data/<path>/README.md
# Kept in git on purpose: web/public/data/ — the app, `pnpm check:routing` and
# the CI build read those prepared browser artifacts.

# macOS metadata
.DS_Store
