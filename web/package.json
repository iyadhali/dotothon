{
  "name": "dotothon-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types scripts/build-db.ts && nuxt dev --host 127.0.0.1",
    "build": "node --experimental-strip-types scripts/build-db.ts && nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "python -m unittest discover -s ../tools/tests -v",
    "db:build": "node --experimental-strip-types scripts/build-db.ts",
    "db:check": "node --experimental-strip-types scripts/build-db.ts --check",
    "test:db": "node --experimental-strip-types --test scripts/db.test.ts",
    "test:routing": "node --experimental-strip-types --test shared/routing/router.test.ts shared/routing/nearby.test.ts",
    "check:routing": "node --experimental-strip-types scripts/check-routing.ts",
    "test:data": "python3 -m unittest discover -s ../scripts/multimodal/tests -v"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "mapbox-gl": "^3.0.0",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@types/geojson": "^7946.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}
